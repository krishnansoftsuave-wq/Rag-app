# LLM provider: "groq" or "gemini". Defaults to groq when GROQ_API_KEY is set, otherwise gemini.
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
# Groq models tried in order (each has its own free daily limit)
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
CHUNK_SIZE=600
CHUNK_OVERLAP=80
DEFAULT_TOP_K=4

# Embedding & Late Chunking Configuration
EMBEDDING_MODEL_NAME=jinaai/jina-embeddings-v2-base-en
USE_LATE_CHUNKING=true
LATE_CHUNKING_MAX_TOKENS=8192
LATE_CHUNKING_STRIDE=1024
